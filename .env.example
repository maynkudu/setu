# Hosted Supabase, Connect > Session pooler. No Supabase Auth or browser API key is needed.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
# Optional session-pooler or direct URL for migrations when the runtime URL differs.
MIGRATION_DATABASE_URL=
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://YOUR-APP.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STUDENT_EMAIL_DOMAINS=ds.study.iitm.ac.in,es.study.iitm.ac.in
MENTOR_EMAIL_DOMAINS=alumni.iitm.ac.in
# Explicit admin Google accounts. Personal accounts are allowed only when listed here.
ADMIN_EMAILS=maynkudu@gmail.com
PROGRAMME_CONTACT_EMAIL=maynkudu@gmail.com
# Per-instance pool limits. Keep total instances × DB_POOL_MAX within your pooler budget.
DB_POOL_MAX=5
DB_QUERY_TIMEOUT_MS=15000
# Optional programme email notifications. Google sign-in works without Resend.
RESEND_API_KEY=
EMAIL_FROM=SETU <mentorship@YOUR-VERIFIED-DOMAIN>
CRON_SECRET=
# Development-only notification inbox. Ignored in production.
LOCAL_EMAIL_CAPTURE=false
